# Copy this file to .env and fill in your actual values
# Never commit the .env file to version control
# ==============================================

# ==============================================
# Django Core Settings
# ==============================================

# Secret key for Django (change this in production!)
#Generate one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=<your secret key for django project>

# Debug mode (set to False in production)
DEBUG=True

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================
# Image Provider Configuration
# ==============================================
# Options: gemini
IMAGE_PROVIDER=flux

# ==============================================
# Google Generative AI (Gemini API)
# ==============================================
# Get API key from: https://console.cloud.google.com/
# 1. Create a new project
# 2. Enable "Generative Language API"
# 3. Go to Credentials > Create API Key
GOOGLE_API_KEY=<your gemini api key>

# ==============================================
# Azure OpenAI (GPT-5-mini) -- PRIMARY text/vision service
# Korea Central resource
# ==============================================
# Endpoint format for Korea Central:
#   https://<your-resource-name>.openai.azure.com
# Do NOT include /openai, /v1, or /models at the end -- the SDK adds them.

AI_PROVIDER_ORDER=azure,gemini

AZURE_OPENAI_ENDPOINT=https://<your project>-resource.services.ai.azure.com/api/projects/<your project>

AZURE_OPENAI_API_KEY=<your zure openai api key>

# Deployment name as configured in Azure OpenAI Studio > Deployments.
# Use "gpt-5-mini" if you created a deployment with that name.
AZURE_OPENAI_MODEL=gpt-5-mini
# API version that exposes GPT-5-mini on your resource.
#   2025-08-01-preview  -> GPT-5-mini preview (recommended for new deployments)
#   2024-10-21         -> stable GA (use this if your resource does not yet
#                        expose GPT-5-mini; the service falls back to
#                        gpt-4o / gpt-4.1 deployments automatically)
AZURE_OPENAI_API_VERSION=2025-08-01-preview

# ==============================================
# Azure AI Foundry FLUX.2-pro API (image generation)
# ==============================================
AZURE_FLUX_ENDPOINT=https://<your project>resource.services.ai.azure.com/providers/blackforestlabs/v1/flux-2-pro
AZURE_FLUX_API_KEY=<you flux api key>
AZURE_FLUX_MODEL=FLUX.2-pro
AZURE_FLUX_API_VERSION=<you azure api version>